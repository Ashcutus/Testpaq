{
  "name": "testpaq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "testpaq": "dist-server/server/cli.js"
  },
  "scripts": {
    "dev": "TESTPAQ_DEV_ORIGIN=http://127.0.0.1:5173 TESTPAQ_SESSION_TOKEN=dev-session TESTPAQ_ENABLE_FIXTURES=1 concurrently -k -n api,ui -c cyan,magenta \"tsx watch server/cli.ts --no-open --port 4178\" \"vite --host 127.0.0.1\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.1.15",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.11",
    "lucide-react": "^0.545.0",
    "open": "^10.2.0",
    "openai": "^7.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.15",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
